{
  "name": "escola-peralta",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native && node scripts/check-bundle.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "admin:create": "node --env-file=.dev.vars scripts/create-admin.mjs",
    "seed": "node --env-file=.dev.vars scripts/seed.mjs",
    "format": "prettier --write src scripts tests *.ts *.mts *.mjs README.md",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --configLoader native",
    "deploy": "npm run build && wrangler deploy",
    "preview:cloudflare": "vite preview --configLoader native --mode cloudflare",
    "pretest:browser": "node tests/browser/build-fixture.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@electric-sql/pglite": "^0.3.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "type": "module"
}
