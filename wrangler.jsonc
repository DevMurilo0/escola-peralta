{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escola-peralta",
  "keep_vars": true,
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": false },
}
